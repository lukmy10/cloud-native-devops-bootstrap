# ==========================================
# 🌍 TERRAFORM (State files & Plugins)
# ==========================================
# Ignore local plugins and data directories
.terraform/
.terraform.*

# Ignore state files (these contain infrastructure secrets!)
*.tfstate
*.tfstate.*

# Ignore the actual local secrets and variables file
terraform/vars.auto.tfvars

# Ignore crash logs
crash.log

# ==========================================
# ⚙️ ANSIBLE & BASH (Temporary files & Logs)
# ==========================================
# Ignore Ansible retry files after failures
*.retry

# Ignore core Ansible logs
ansible.log

# Ignore summary and credentials generated by final.sh to prevent leaks
*summary*.log
*credentials*.txt

# ==========================================
# 🔑 SECURITY (Access Keys & Certyficates)
# ==========================================
# Never commit private keys to GitHub!
*.pem
*.key
*.pub
id_rsa
id_rsa.pub

# Ignore cluster configuration files retrieved during bootstrap
*kubeconfig*
*.kube/config

# ==========================================
# 💻 SYSTEM (Operating System garbage)
# ==========================================
.DS_Store
Thumbs.db
.idea/
.vscode/
